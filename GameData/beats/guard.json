{
  "beats": [
    {
      "id": "guard.c1.first",
      "on": "talk:guard",
      "when": ["stage:S01_Arrival"],
      "once": "story",
      "priority": 20,
      "note": "[임시 대사] 1회차 경비는 평범하다. 막지 않는다.",
      "lines": [
        "guard: 성에 볼일 있소?",
        { "pause": 0.8, "speaker": "guard", "text": "……뭐, 없어도 상관없소. 오늘은 문이 열려 있으니." },
        "guard: 안에서 뛰지만 마시오. 바닥 닦은 지 얼마 안 됐소."
      ],
      "effects": ["set:MetGuard"],
      "choices": [
        { "text": "왕은 어떤 분이야?", "next": "guard.c1.king" },
        { "text": "고마워." }
      ]
    },
    {
      "id": "guard.c1.king",
      "lines": [
        "guard: 좋은 분이시오.",
        { "pause": 1.0, "speaker": "guard", "text": "말씀이 좀 많으시지만." },
        "guard: ……이건 내가 했다고 하지 마시오."
      ]
    },
    {
      "id": "guard.c1.repeat",
      "on": "talk:guard",
      "when": ["stage:S01_Arrival"],
      "priority": 10,
      "lines": ["guard: 들어갈 거면 들어가시오. 문 앞에 서 있으면 내가 할 일이 생기잖소."]
    },

    {
      "id": "guard.c2.recognize",
      "on": "talk:guard",
      "when": ["stage:S02_GateClosed", "flag:EnteredCastle"],
      "once": "story",
      "priority": 30,
      "note": "핸드오프 12장 비트 그대로. 경비는 '또 왔군'이 아니라 '어제'만 기억한다 — 루프는 플레이어 등장 이후 생긴 현상.",
      "lines": [
        "player: 어제는 들어갈 수 있었잖아.",
        "guard: 어제?",
        { "pause": 1.2, "speaker": "guard", "text": "……어디서 본 것 같은데.", "cue": "GuardStare" },
        { "pause": 1.5, "speaker": "guard", "text": "아. 어제 성문 앞에서 쓰러진 사람이 자네였나?" }
      ],
      "effects": ["set:GuardRecognizesPlayer"],
      "next": "guard.c2.hub"
    },
    {
      "id": "guard.c2.hub",
      "choices": [
        { "text": "성문 앞? 성 안에서 쓰러졌는데.", "when": ["!seen:guard.c2.where@cycle"], "next": "guard.c2.where" },
        { "text": "문은 왜 닫혀 있어?", "when": ["!seen:guard.c2.why@cycle"], "next": "guard.c2.why" },
        { "text": "……아무것도 아니야." }
      ]
    },
    {
      "id": "guard.c2.where",
      "note": "제안: 플레이어는 '성 안'에서 쓰러졌는데 경비는 '성문 앞'에서 봤다. 핸드오프 12장 대사에 이미 있는 어긋남을 첫 미스터리 씨앗으로 쓴다. 경비는 거짓말하지 않는다 — 실제로 그렇게 봤다.",
      "lines": [
        "guard: 성 안?",
        { "pause": 1.0, "speaker": "guard", "text": "……글쎄. 내가 봤을 땐 여기, 이 문 앞이었소." }
      ],
      "effects": ["set:HeardWhereFainted"],
      "next": "guard.c2.hub"
    },
    {
      "id": "guard.c2.why",
      "note": "제안: 농담으로 시작해서 아주 작은 균열로 끝난다. 너무 이르다고 느껴지면 마지막 줄만 삭제.",
      "lines": [
        "guard: 위에서 닫으라면 닫는 거요. 나는 문지기지, 문 철학자가 아니오.",
        { "pause": 1.2, "speaker": "guard", "text": "……그러고 보니 누가 닫으라고 했더라." }
      ],
      "next": "guard.c2.hub"
    },
    {
      "id": "guard.c2.repeat",
      "on": "talk:guard",
      "when": ["stage:S02_GateClosed"],
      "priority": 10,
      "lines": ["guard: 오늘은 안 되오. 내일 다시 오시오."]
    },

    {
      "id": "guard.c3.tomorrow",
      "on": "talk:guard",
      "when": ["stage:S03_OpenAgain", "seen:guard.c2.repeat@prev"],
      "once": "story",
      "priority": 31,
      "note": "[임시 대사] 어제 '내일 다시 오시오'를 들은 경우. 경비의 기억은 3회차까지 정확하다 (14장).",
      "lines": [
        "player: 어제는 내일 오라며.",
        "guard: 그랬지. 그래서 열어뒀소.",
        { "pause": 0.8, "speaker": "guard", "text": "……열라고 해서 열었소." }
      ],
      "next": "guard.c3.straw"
    },
    {
      "id": "guard.c3.open",
      "on": "talk:guard",
      "when": ["stage:S03_OpenAgain", "!seen:guard.c3.tomorrow"],
      "once": "story",
      "priority": 30,
      "lines": [
        "guard: 오늘은 열려 있소.",
        { "pause": 0.8, "speaker": "guard", "text": "……열라고 해서 열었소." }
      ],
      "next": "guard.c3.straw"
    },
    {
      "id": "guard.c3.straw",
      "note": "[임시 대사] 개그: 이틀 연속 쓰러진 사람을 위해 짚을 깔아뒀다. 마지막 줄은 1회차 대사(바닥 닦은 지…)의 재활용 — 기억하는 플레이어에게만 웃기다.",
      "lines": [
        "guard: 저건 짚이오. 이틀 연속 여기서 쓰러진 사람은 처음 봐서.",
        "guard: 오늘도 쓰러질 거면 저기로 쓰러지시오. 바닥 닦은 지 얼마 안 됐소."
      ],
      "choices": [
        { "text": "누가 열라고 했는데?", "next": "guard.c3.who" },
        { "text": "……고마워." }
      ]
    },
    {
      "id": "guard.c3.who",
      "note": "제안: 2회차 '누가 닫으라고 했더라'의 연장. 위가 어딘지는 끝까지 말하지 않는다.",
      "lines": [
        "guard: 위에서.",
        { "pause": 1.0, "speaker": "guard", "text": "……위가 어딘지는 묻지 마시오. 나도 모르니까." }
      ]
    },
    {
      "id": "guard.c3.repeat",
      "on": "talk:guard",
      "when": ["stage:S03_OpenAgain"],
      "priority": 10,
      "lines": ["guard: 짚은 저기 있소. 쓰러질 거면 그쪽으로."]
    },

    {
      "id": "guard.c4.well",
      "on": "talk:guard",
      "when": ["stage:S04_OutOfPlace"],
      "once": "story",
      "priority": 30,
      "note": "[임시 대사] 성문을 비우고 우물가에 앉아 성만 본다. 농담 없음. 본인도 무슨 일인지 모른다.",
      "lines": [
        { "pause": 0.8, "speaker": "guard", "text": "……아, 자네군." },
        "guard: 오늘은 문 앞에 서 있을 기분이 아니오.",
        "guard: 어젯밤에 성문 열리는 소리를 들었소. 나가 보니 닫혀 있더군.",
        { "pause": 1.2, "speaker": "guard", "text": "……문지기가 문 꿈을 꾸면 안 되는 거요." }
      ]
    },
    {
      "id": "guard.c4.repeat",
      "on": "talk:guard",
      "when": ["stage:S04_OutOfPlace"],
      "priority": 10,
      "lines": ["guard: ……응? 아, 아무것도 아니오. 성을 좀 보고 있었소."]
    },

    {
      "id": "guard.c5.first",
      "on": "talk:guard",
      "when": ["stage:S05_FirstDayAgain"],
      "once": "story",
      "priority": 30,
      "note": "가짜 첫날 (오너 결정: 둘 다 잊음). 대사는 guard.c1.first를 **일부러 그대로** 복사.",
      "lines": [
        "guard: 성에 볼일 있소?",
        { "pause": 0.8, "speaker": "guard", "text": "……뭐, 없어도 상관없소. 오늘은 문이 열려 있으니." },
        "guard: 안에서 뛰지만 마시오. 바닥 닦은 지 얼마 안 됐소."
      ],
      "choices": [
        { "text": "나 몰라?", "next": "guard.c5.stranger" },
        { "text": "왕은 어떤 분이야?", "next": "guard.c1.king" },
        { "text": "고마워." }
      ]
    },
    {
      "id": "guard.c5.stranger",
      "lines": [
        "guard: ……초면 같은데.",
        { "pause": 0.8, "speaker": "guard", "text": "사람 얼굴은 잘 잊지 않는 편이오." }
      ]
    },
    {
      "id": "guard.c5.repeat",
      "on": "talk:guard",
      "when": ["stage:S05_FirstDayAgain"],
      "priority": 10,
      "lines": ["guard: 들어갈 거면 들어가시오. 문 앞에 서 있으면 내가 할 일이 생기잖소."]
    },

    {
      "id": "guard.idle",
      "on": "talk:guard",
      "priority": 0,
      "lines": ["guard: 수고하시오."]
    }
  ]
}
