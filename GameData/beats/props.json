{
  "beats": [
    {
      "id": "castle.c1.enter",
      "on": "enter:castle_foyer",
      "when": ["stage:S01_Arrival"],
      "once": "cycle",
      "note": "1회차 기절. 대사 없음 — 이명/흐림/흔들림/암전은 전부 연출(BP) 담당. 핵심은 이유 없이 쓰러진다는 것.",
      "effects": ["set:EnteredCastle", "faint:CastleInterior"]
    },

    {
      "id": "gate.c2.intercept",
      "on": "use:gate",
      "when": ["stage:S02_GateClosed", "!seen:guard.c2.recognize"],
      "priority": 20,
      "note": "경비와 대화하지 않고 성문부터 만지려는 플레이어도 '알아보는 순간'을 놓치지 않게 한다.",
      "lines": [
        { "speaker": "guard", "text": "어이, 거기. 문 닫힌 거 안 보이시오?", "cue": "GuardTurnsToPlayer" }
      ],
      "next": "guard.c2.recognize"
    },
    {
      "id": "gate.c2.touch",
      "on": "use:gate",
      "when": ["stage:S02_GateClosed", "seen:guard.c2.recognize"],
      "once": "cycle",
      "priority": 10,
      "note": "2회차 기절. 경비의 대사가 끝나기 전에 연출이 덮어야 한다 (줄 끝의 '—').",
      "lines": [
        { "speaker": "guard", "text": "이봐, 손대지 말라니까—", "cue": "GateTouch" }
      ],
      "effects": ["faint:GateTouch"]
    },

    {
      "id": "gate.c3.threshold",
      "on": "enter:gate_threshold",
      "when": ["stage:S03_OpenAgain"],
      "once": "cycle",
      "note": "3회차 기절. 현관이 아니라 문턱 — 1회차보다 빨리 온다. 경비가 짚 쪽으로 안내한다 (개그).",
      "lines": [
        { "speaker": "guard", "text": "벌써? 짚, 짚 쪽으로—" }
      ],
      "effects": ["faint:GateThreshold"]
    },
    {
      "id": "gate.c4.approach",
      "on": "enter:gate_approach",
      "when": ["stage:S04_OutOfPlace"],
      "once": "cycle",
      "note": "4회차: 성문에 다가가기만 해도 아주 작은 이명. 대사 없음.",
      "effects": ["cue:EarlyTinnitus"]
    },
    {
      "id": "gate.c4.touch",
      "on": "use:gate",
      "when": ["stage:S04_OutOfPlace"],
      "once": "cycle",
      "priority": 10,
      "note": "4회차 기절. 말리는 건 경비가 아니라 꼬맹이 — 꼬맹이가 기절을 직접 본다 (5회차에 꼬맹이만 기억하는 이유).",
      "lines": [
        { "speaker": "kid", "text": "아저씨, 그거 만지면 안 된다고 경비 아저씨가—", "cue": "GateTouch" }
      ],
      "effects": ["faint:GateTouch"]
    },
    {
      "id": "castle.c5.enter",
      "on": "enter:castle_foyer",
      "when": ["stage:S05_FirstDayAgain"],
      "once": "cycle",
      "note": "5회차 기절 = WAKE UP! (15장). 대사 없음. 1회차와 같은 자리, 같은 순서 — 그래서 깨지는 게 보인다.",
      "effects": ["faint:WakeUp"]
    },

    {
      "id": "straw.c3",
      "on": "use:straw",
      "when": ["stage:S03_OpenAgain"],
      "lines": ["player: 짚더미다. 누울 자리까지 챙겨 주는 문지기라니."]
    },
    {
      "id": "straw.c4",
      "on": "use:straw",
      "when": ["stage:S04_OutOfPlace"],
      "lines": ["player: 어제 그 짚이다. 내가 누웠던 자국이 그대로 남아 있다."]
    },

    {
      "id": "drawing.king_waving",
      "on": "use:chalk_drawing",
      "when": ["world:chalk_drawing.state=king_waving"],
      "note": "임금님은 이 낙서 속에만 있다 (오너 결정: 직접 보여주지 않음).",
      "lines": ["player: 분필로 그린 성이다. 제일 높은 창문에서 왕관 쓴 막대 인간이 손을 흔들고 있다."]
    },
    {
      "id": "drawing.one_lying",
      "on": "use:chalk_drawing",
      "when": ["world:chalk_drawing.state=one_lying"],
      "lines": ["player: 성문 앞에 작은 막대 인간이 누워 있다. 옆에 삐뚤빼뚤한 글씨로 '아저씨'."]
    },
    {
      "id": "drawing.two_lying",
      "on": "use:chalk_drawing",
      "when": ["world:chalk_drawing.state=two_lying"],
      "lines": ["player: 성문 앞에 막대 인간 둘이 나란히 누워 있다. 둘 다 '아저씨'."]
    },
    {
      "id": "drawing.three_lying",
      "on": "use:chalk_drawing",
      "when": ["world:chalk_drawing.state=three_lying_window_black"],
      "lines": ["player: 누운 막대 인간이 셋. 성의 높은 창문은 까맣게 칠해져 있다."]
    },
    {
      "id": "drawing.erased",
      "on": "use:chalk_drawing",
      "when": ["world:chalk_drawing.state=erased"],
      "lines": ["player: 분필 자국만 희미하게 남아 있다. 누가 문질러 지운 것 같다."]
    },

    {
      "id": "firewood.take",
      "on": "use:firewood",
      "when": ["!flag:CarryingFirewood"],
      "priority": 10,
      "note": "인벤토리 없음. '들고 있다'는 회차 플래그 하나로 끝.",
      "effects": ["set:CarryingFirewood", "cue:PickUpFirewood"]
    }
  ]
}
